{
  "description": "Run focused lint after Codex edits and full lint before Codex pushes.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/lint-changed.mjs\"",
            "timeout": 120,
            "statusMessage": "Linting changed source files"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/lint-before-push.mjs\"",
            "timeout": 120,
            "statusMessage": "Running full lint before push"
          }
        ]
      }
    ]
  }
}
