{
  "name": "screen-spec",
  "version": "0.1.0",
  "private": true,
  "description": "画面詳細設計書を記述する OpenAPI ライクな言語仕様と、その Viewer",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "validate": "tsx packages/cli/src/index.ts validate",
    "testgen": "tsx packages/cli/src/index.ts testgen",
    "test": "vitest run && node --test .codex/hooks/*.node-test.mjs apps/viewer/scripts/*.node-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "lint:files": "eslint --max-warnings=0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "vitest": {
      "vite": "5.4.21"
    }
  }
}
